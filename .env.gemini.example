# Fluxa Voice Intent Gemini Evaluator
# Copy this file to project root as:
# .env
#
# Never commit .env to Git.

# Required
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional
# Recommended starting model for parser evaluation.
GEMINI_MODEL=gemini-2.5-flash

# Optional
# Keep v1beta unless you intentionally migrate.
GEMINI_API_VERSION=v1beta
